includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5

    # Capas refactorizadas (dominio, tenancy, HTTP nuevo y pruebas de soporte).
    # El código heredado se incorpora módulo por módulo a medida que se migra.
    paths:
        - app/Tenancy
        - app/Repositories
        - app/Services/Finanzas
        - app/Services/Citas
        - app/DTOs
        - app/Enums
        - app/Exceptions
        - app/Policies
        - app/Support/Minutos.php
        - app/Http/Controllers/Finanzas
        - app/Http/Controllers/Citas
        - app/Http/Controllers/Concerns
        - app/Http/Middleware/ResolveTenant.php
        - app/Http/Middleware/ResolvePublicTenant.php
        - app/Http/Requests/TenantFormRequest.php
        - app/Http/Requests/ListadoRequest.php
        - app/Http/Requests/Finanzas
        - app/Http/Requests/Citas

    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        - identifier: nullsafe.neverNull
